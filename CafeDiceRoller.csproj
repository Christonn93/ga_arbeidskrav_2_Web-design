<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Keep the nested test project out of this web project's default globs. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);CafeDiceRoller.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazorise.Icons.Lucide" Version="2.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\Container.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\ContainerHeader.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\EmptyState.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\InfoMessage.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\LoadError.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\Loading.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\Section.razor" />
    <_ContentIncludedByDefault Remove="docs\AiChats\Default\SectionHeader.razor" />
    <RazorComponent Remove="docs\AiChats\**\*.razor" />
    <Content Remove="docs\AiChats\**\*.razor" />
    <None Include="docs\AiChats\**\*.razor" />
  </ItemGroup>

</Project>