@inherits LayoutComponentBase

<div class="min-h-dvh flex flex-col bg-cafe-bg text-cafe-text">
    <Header />

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
        @Body
    </main>

    <Footer />
</div>

<div id="blazor-error-ui" data-nosnippet
     class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 surface px-4 py-3 shadow-lg z-50">
    Det oppstod en uventet feil.
    <a href="." class="reload text-accent underline ml-2">Last inn på nytt</a>
    <span class="dismiss cursor-pointer ml-3 text-cafe-muted">✕</span>
</div>