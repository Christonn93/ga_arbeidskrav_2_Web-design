@page "/"

<PageTitle>Kafé Terningkast — Finn ditt neste brettspill</PageTitle>

@* ============================================================
   HERO
   ============================================================ *@
<section class="relative overflow-hidden py-12 sm:py-20">
    @* Decorative blurred dice glow behind the headline *@
    <div aria-hidden="true"
         class="pointer-events-none absolute -top-20 right-[-10%] h-72 w-72 rounded-full
                bg-phosphor/10 blur-3xl sm:h-96 sm:w-96"></div>

    <div class="relative">
        <p class="terminal-label">// Velkommen til Kafé Terningkast</p>

        <h1 class="mt-4 font-display text-4xl font-bold leading-tight tracking-tight sm:text-6xl lg:text-7xl caret">
            Finn ditt neste
            <span class="text-neon">brettspill</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base text-cafe-muted sm:text-lg">
            Hylla er full, papirlista er borte, og kvelden er ung.
            Bla gjennom spillsamlingen, trill terningen for inspirasjon,
            og sett sammen kveldens spilliste på sekunder.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
            <a href="/games"
               class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-medium
                      text-cafe-bg transition hover:bg-accent-hover
                      focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-cafe-bg">
                <span aria-hidden="true">🎲</span>
                Utforsk spillhylla
            </a>
            <a href="/game-night"
               class="inline-flex items-center gap-2 rounded-lg border border-cafe-border
                      px-5 py-3 text-sm font-medium text-cafe-text
                      transition hover:border-accent hover:text-accent">
                Min spillekveld
            </a>
        </div>

        @* Small trust strip under the CTAs *@
        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 text-sm">
            <div>
                <dt class="terminal-label">Spill i hylla</dt>
                <dd class="mt-1 font-display text-2xl font-bold text-cafe-text">10+</dd>
            </div>
            <div>
                <dt class="terminal-label">Kategorier</dt>
                <dd class="mt-1 font-display text-2xl font-bold text-cafe-text">6</dd>
            </div>
            <div>
                <dt class="terminal-label">Åpningstid</dt>
                <dd class="mt-1 font-display text-2xl font-bold text-cafe-text">10–23</dd>
            </div>
        </dl>
    </div>
</section>

@* ============================================================
   FEATURE CARDS
   ============================================================ *@
<section class="py-10 sm:py-16">
    <div class="max-w-2xl">
        <p class="terminal-label">// Hva kan du gjøre her?</p>
        <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">
            Tre steg fra «hva skal vi spille?» til «neste runde»
        </h2>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <li class="surface group flex flex-col gap-3 p-5 transition hover:border-accent">
            <span class="flex h-10 w-10 items-center justify-center rounded-md
                         border border-cafe-border bg-cafe-surface-hi text-xl"
                  aria-hidden="true">🔍</span>
            <h3 class="font-display text-lg font-bold">Finn et spill</h3>
            <p class="text-sm text-cafe-muted">
                Søk på navn, filtrer på antall spillere, eller la terningen velge blant
                treffene når du ikke klarer å bestemme deg.
            </p>
            <a href="/games"
               class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-accent
                      transition group-hover:gap-2">
                Til spillhylla <span aria-hidden="true">→</span>
            </a>
        </li>

        <li class="surface group flex flex-col gap-3 p-5 transition hover:border-accent">
            <span class="flex h-10 w-10 items-center justify-center rounded-md
                         border border-cafe-border bg-cafe-surface-hi text-xl"
                  aria-hidden="true">⭐</span>
            <h3 class="font-display text-lg font-bold">Gi terningkast</h3>
            <p class="text-sm text-cafe-muted">
                Åpne et spill, les detaljene, og gi din egen vurdering fra 1 til 6 —
                akkurat som i den gamle papirlista, men uten at noen glemmer å oppdatere den.
            </p>
            <a href="/games"
               class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-accent
                      transition group-hover:gap-2">
                Se et spill <span aria-hidden="true">→</span>
            </a>
        </li>

        <li class="surface group flex flex-col gap-3 p-5 transition hover:border-accent sm:col-span-2 lg:col-span-1">
            <span class="flex h-10 w-10 items-center justify-center rounded-md
                         border border-cafe-border bg-cafe-surface-hi text-xl"
                  aria-hidden="true">🌙</span>
            <h3 class="font-display text-lg font-bold">Planlegg kvelden</h3>
            <p class="text-sm text-cafe-muted">
                Legg spill til spillekvelden din mens du blar. Se samlet spilletid,
                og hold oversikten helt til dere setter dere ned.
            </p>
            <a href="/game-night"
               class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-accent
                      transition group-hover:gap-2">
                Min spillekveld <span aria-hidden="true">→</span>
            </a>
        </li>

    </ul>
</section>

@* ============================================================
   HOW IT WORKS — short numbered strip
   ============================================================ *@
<section class="surface mt-6 p-6 sm:p-8">
    <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:gap-12">

        <div class="lg:max-w-xs">
            <p class="terminal-label">// Slik funker det</p>
            <h2 class="mt-3 font-display text-xl font-bold tracking-tight sm:text-2xl">
                Fra gruppe til spilliste på under et minutt
            </h2>
            <p class="mt-3 text-sm text-cafe-muted">
                Ingen app-innlogging, ingen papirliste, ingen «hvem har lånt Catan?».
            </p>
        </div>

        <ol class="grid gap-6 sm:grid-cols-3">
            <li class="flex gap-4">
                <span class="font-mono text-2xl font-bold text-accent">01</span>
                <div>
                    <h3 class="font-medium">Bla i hylla</h3>
                    <p class="mt-1 text-sm text-cafe-muted">
                        Se alle spillene med kategori, spilletid og terningkast.
                    </p>
                </div>
            </li>
            <li class="flex gap-4">
                <span class="font-mono text-2xl font-bold text-accent">02</span>
                <div>
                    <h3 class="font-medium">Velg og legg til</h3>
                    <p class="mt-1 text-sm text-cafe-muted">
                        Trykk på et spill du vil ha med, så havner det i spillekvelden.
                    </p>
                </div>
            </li>
            <li class="flex gap-4">
                <span class="font-mono text-2xl font-bold text-accent">03</span>
                <div>
                    <h3 class="font-medium">Se samlet tid</h3>
                    <p class="mt-1 text-sm text-cafe-muted">
                        Få oversikt over antall spill og estimert total spilletid.
                    </p>
                </div>
            </li>
        </ol>
    </div>
</section>

@* ============================================================
   STAFF TEASER
   ============================================================ *@
<section class="py-12 sm:py-20">
    <div class="surface flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md
                     border border-cafe-border bg-cafe-surface-hi text-2xl"
              aria-hidden="true">🛠️</span>
        <div class="flex-1">
            <p class="terminal-label">// For ansatte</p>
            <h2 class="mt-2 font-display text-lg font-bold sm:text-xl">
                Bak disken — vedlikehold spillsamlingen
            </h2>
            <p class="mt-2 max-w-2xl text-sm text-cafe-muted">
                Legg til nye spill, rett opp feil, eller fjern spill som har forsvunnet ut av hylla.
                Endringene vises umiddelbart for gjestene.
            </p>
        </div>
        <a href="/admin/games"
           class="inline-flex items-center gap-2 rounded-lg border border-cafe-border
                  px-4 py-2.5 text-sm font-medium text-cafe-text
                  transition hover:border-accent hover:text-accent">
            Til administrasjon <span aria-hidden="true">→</span>
        </a>
    </div>
</section>