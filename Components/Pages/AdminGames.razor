@page "/admin/games"
@using CafeDiceRoller.Components.Ui.Card
@using CafeDiceRoller.Components.Ui.Popup
@rendermode InteractiveServer

<PageTitle>Spilladministrasjon</PageTitle>

<Section>
    <div class="mb-6 flex items-start justify-between gap-4">
        <SectionHeader
            HeaderText="Spilladministrasjon"
            HeaderDescription="Legg til, rediger og fjern spill i samlingen.">
            <Actions>
                <Button Type="button" OnClick="OpenCreate">
                    Nytt spill
                </Button>
            </Actions>
        </SectionHeader>
    </div>

    @if (_loading)
    {
        <Loading />
    }
    else if (_loadError is not null)
    {
        <ErrorCard ErrorMessage="@_loadError" />
    }
    else if (_games.Count == 0)
    {
        <EmptyState Title="No games yet. Add the first one." />
    }
    else
    {
        @if (_saveError is not null)
        {
            <ErrorCard ErrorMessage="@_saveError" />
        }

        <ul class="flex flex-col gap-3">
            @foreach (var game in _games)
            {
                <li @key="game.Id"
                    class="flex flex-col gap-3 rounded-md border border-zinc-200 p-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="font-medium text-zinc-900 dark:text-zinc-100">
                            @game.Name
                        </p>

                        <p class="text-sm text-zinc-600">
                            @game.Category · @game.MinPlayers–@game.MaxPlayers players · @game.PlayTimeMinutes min
                        </p>
                    </div>

                    <div class="flex gap-2">
                        <Button Type="button"
                                Variant="secondary"
                                OnClick="() => Edit(game)">
                            Rediger
                        </Button>

                        <Button Type="button"
                                Variant="danger"
                                OnClick="() => AskDelete(game)">
                            Slett
                        </Button>
                    </div>
                </li>
            }
        </ul>
    }
</Section>

<Popup @bind-Visible="_showForm"
       Title="@(_editingId is null ? "New game" : "Edit game")"
       CloseOnBackdrop="false">
    <ChildContent>
        <GameForm Model="_form"
                  OnSave="Save"
                  OnCancel="CloseForm" />
    </ChildContent>
</Popup>

<Popup @bind-Visible="_showDelete"
       Title="Delete game">
    <ChildContent>
        <p>Delete @_pendingDelete?.Name? This cannot be undone.</p>
    </ChildContent>

    <Footer>
        <Button Type="button"
                Variant="secondary"
                OnClick="CancelDelete">
            Cancel
        </Button>

        <Button Type="button"
                Variant="danger"
                OnClick="ConfirmDelete">
            Delete
        </Button>
    </Footer>
</Popup>