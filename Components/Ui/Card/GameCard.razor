@using CafeDiceRoller.Components.Ui.Rating
@using CafeDiceRoller.Models
@using Microsoft.AspNetCore.Components

<article class="game-card @(Highlighted ? "game-card--highlighted" : null)">
    <div class="game-card__top">
        <span class="game-card__category">@Game.Category</span>

        @if (Highlighted)
        {
            <!-- Badge shown when the dice picked this game. -->
            <span class="game-card__pick">
                <span aria-hidden="true">⚄</span>
                Terningen valgte
            </span>
        }
    </div>

    <div class="game-card__content">
        <h2 class="game-card__title">
            <a href="@($"/games/{Game.Id}")">@Game.Name</a>
        </h2>

        <p class="game-card__description">@Game.Description</p>
    </div>

    <footer class="game-card__footer">
        <div class="game-card__details">
            <span class="game-card__detail">
                <span class="game-card__detail-icon" aria-hidden="true">♟</span>
                @Game.MinPlayers–@Game.MaxPlayers
            </span>

            <span class="game-card__detail">
                <span class="game-card__detail-icon" aria-hidden="true">◷</span>
                @Game.PlayTimeMinutes min
            </span>

            <span class="game-card__rating" aria-label="Terningkast">
                <DiceRating Value="Game.Rating" ReadOnly="true" />
            </span>
        </div>

        <button type="button"
                class="game-card__action @(IsInGameNight ? "game-card__action--added" : null)"
                disabled="@IsInGameNight"
                @onclick="HandleAddToNight"
                aria-label="@(IsInGameNight
                    ? $"{Game.Name} er lagt til i spillekvelden"
                    : $"Legg {Game.Name} til i spillekvelden")">
            @if (IsInGameNight)
            {
                <span aria-hidden="true">✓</span>
                <span>Lagt til</span>
            }
            else
            {
                <span aria-hidden="true">+</span>
                <span>Legg til</span>
            }
        </button>
    </footer>
</article>
