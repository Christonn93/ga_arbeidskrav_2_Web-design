@using CafeDiceRoller.Components.Ui.Typography

<header>
    <Typography Variant="h1">
        @HeaderText
    </Typography>
    @if (HeaderDescription is not null)
    {
        <!-- Renders the description only when provided. -->
        <Typography Variant="muted">
            @HeaderDescription
        </Typography>
    }
</header>

@code {
    // Main heading text shown at the top.
    [Parameter] public string HeaderText { get; set; } = "Header text";
    // Optional description shown below the heading.
    [Parameter] public string? HeaderDescription { get; set; }
}