@implements IDisposable

@if (!string.IsNullOrWhiteSpace(Message))
{
    <!-- Auto-dismissing info banner with manual close. -->
    <div class="notice-banner" role="status">
        <span>✓ @Message</span>
        <button type="button"
                class="notice-banner__close"
                aria-label="Lukk melding"
                @onclick="Dismiss">
            ✕
        </button>
    </div>
}

@code {
    // Message text to display; hidden when empty.
    [Parameter]
    public string? Message { get; set; }

    // Auto-dismiss delay in milliseconds.
    [Parameter]
    public int DurationMs { get; set; } = 5000;

    // Raised when the banner is dismissed.
    [Parameter]
    public EventCallback OnDismiss { get; set; }

    // Token source for the current auto-dismiss timer.
    private CancellationTokenSource? _cts;
    // Last message the timer was scheduled for.
    private string? _scheduledMessage;

    // Restarts the dismiss timer when the message changes.
    protected override void OnParametersSet()
    {
        if (Message == _scheduledMessage)
        {
            return;
        }

        _scheduledMessage = Message;
        RestartTimer();
    }

    // Cancels any existing timer and starts a new one.
    private void RestartTimer()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        if (string.IsNullOrWhiteSpace(Message))
        {
            return;
        }

        _cts = new CancellationTokenSource();
        _ = DismissAfter(_cts.Token);
    }

    // Waits for the delay, then invokes OnDismiss.
    private async Task DismissAfter(CancellationToken token)
    {
        try
        {
            await Task.Delay(DurationMs, token);
            await OnDismiss.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Dismisses immediately when the close button is clicked.
    private Task Dismiss() => OnDismiss.InvokeAsync();

    // Cancels and disposes any pending timer.
    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}