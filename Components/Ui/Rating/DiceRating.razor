@using Microsoft.AspNetCore.Components

@if (ReadOnly)
{
    <!-- Static dice rating display. -->
    <span class="inline-flex items-center gap-1.5 text-sm text-cafe-muted"
          role="img"
          aria-label="@($"Terningkast {DisplayValue} av 6")">
        <span aria-hidden="true" class="text-xl leading-none text-cafe-text">
            @FaceGlyph
        </span>

        <span aria-hidden="true">@DisplayValue/6</span>
    </span>
}
else
{
    <!-- Clickable dice that cycles through 1-6. -->
    <Button Type="button"
                OnClick="Cycle"
                AriaLabel="@($"Terningkast {DisplayValue} av 6. Klikk for neste verdi.")"
                CssClass="inline-flex min-h-11 items-center gap-2 rounded-md
                          border border-cafe-border px-3 py-2 text-sm text-cafe-text
                          hover:bg-cafe-surface-hi
                          focus-visible:outline-2 
                          focus-visible:outline-offset-2 focus-visible:outline-accent">
        <span aria-hidden="true" class="text-xl leading-none">
            @FaceGlyph
        </span>

        <span aria-hidden="true">@DisplayValue/6</span>
    </Button>
}

@code {
    // Current rating value (1-6).
    [Parameter]
    public int Value { get; set; } = 1;

    // Raised when the value changes via click.
    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    // When true, the rating is display-only.
    [Parameter]
    public bool ReadOnly { get; set; }

    // Clamped value kept within 1-6 for display.
    private int DisplayValue => Math.Clamp(Value, 1, 6);

    // Unicode die face matching the current value.
    private string FaceGlyph => DisplayValue switch
    {
        1 => "⚀",
        2 => "⚁",
        3 => "⚂",
        4 => "⚃",
        5 => "⚄",
        6 => "⚅",
        _ => "?"
    };

    // Advances the value 1→6, wrapping back to 1.
    private async Task Cycle()
    {
        if (ReadOnly)
        {
            return;
        }

        var next = DisplayValue >= 6 ? 1 : DisplayValue + 1;
        await ValueChanged.InvokeAsync(next);
    }
}