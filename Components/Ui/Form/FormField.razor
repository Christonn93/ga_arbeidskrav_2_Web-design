@using System.Linq.Expressions
@typeparam TValue

<div class="flex flex-col gap-1.5">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@InputId" class="text-sm font-medium text-zinc-700 dark:text-zinc-200">
            @Label
        </label>
    }

    @ChildContent

    @if (For is not null)
    {
        <!-- Shows validation messages when bound to a field. -->
        <FormValidationMessage TValue="TValue" For="For" />
    }
</div>

@code {
    // Optional label text shown above the field.
    [Parameter]
    public string? Label { get; set; }

    // Id linking the label to the input element.
    [Parameter]
    public string? InputId { get; set; }

    // Field expression used for validation messages.
    [Parameter]
    public Expression<Func<TValue>>? For { get; set; }

    // Content rendered inside the field wrapper.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}