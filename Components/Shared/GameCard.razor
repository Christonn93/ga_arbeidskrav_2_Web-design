@using CafeDiceRoller.Models
@using Microsoft.AspNetCore.Components

<article class="relative py-5
                @(Highlighted ? "bg-cafe-surface-hi" : "")">

    @if (Highlighted)
    {
        <p class="mb-2 text-sm font-medium text-cafe-text">
            Terningen valgte
        </p>
    }

    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0 flex-1">
            <p class="mb-1 text-sm text-cafe-muted">
                @Game.Category
            </p>

            <h2 class="font-display text-xl font-semibold leading-tight">
                <a href="@($"/games/{Game.Id}")"
                   class="rounded-sm text-cafe-text
                          decoration-1 underline-offset-4 hover:underline
                          focus-visible:outline focus-visible:outline-2
                          focus-visible:outline-offset-4 focus-visible:outline-accent">
                    @Game.Name
                </a>
            </h2>

            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-cafe-muted">
                @Game.Description
            </p>

            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2
                        text-sm text-cafe-muted">
                <span>@Game.MinPlayers–@Game.MaxPlayers spillere</span>
                <span>@Game.PlayTimeMinutes min</span>
                <DiceRating Value="Game.Rating" ReadOnly="true" />
            </div>
        </div>

        <button type="button"
                @onclick="HandleAddToNight"
                disabled="@IsInGameNight"
                aria-label="@(IsInGameNight
                    ? $"{Game.Name} er lagt til i spillekvelden"
                    : $"Legg {Game.Name} til i spillekvelden")"
                class="min-h-11 shrink-0 self-start rounded-md border
                       border-cafe-border px-4 py-2 text-sm font-medium
                       text-cafe-text
                       enabled:hover:bg-cafe-surface-hi
                       focus-visible:outline focus-visible:outline-2
                       focus-visible:outline-offset-2 focus-visible:outline-accent
                       disabled:cursor-default disabled:text-cafe-muted">
            @(IsInGameNight ? "Lagt til" : "Legg til")
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = default!;

    [Parameter]
    public bool Highlighted { get; set; }

    [Parameter]
    public bool IsInGameNight { get; set; }

    [Parameter]
    public EventCallback<BoardGame> OnAddToGameNight { get; set; }

    private async Task HandleAddToNight()
    {
        if (IsInGameNight)
        {
            return;
        }

        await OnAddToGameNight.InvokeAsync(Game);
    }
}