@using System.ComponentModel.DataAnnotations
@using CafeDiceRoller.Components.Ui.Form
@using CafeDiceRoller.Components.Ui.Rating

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" class="flex flex-col gap-6">
    <DataAnnotationsValidator />

    <div class="flex flex-col gap-4 md:flex-row">
        <div class="flex flex-1 flex-col gap-4">
            <FormInputField Label="Navn" @bind-Value="Model.Name" />
            <FormInputField Label="Kategori" @bind-Value="Model.Category" />
        </div>

        <div class="flex flex-1 flex-col gap-4">
            <FormField TValue="int" Label="Min. spillere" InputId="min-players">
                <InputNumber id="min-players"
                             class="@NumberClass(() => Model.MinPlayers)"
                             @bind-Value="Model.MinPlayers" />
                <FormValidationMessage TValue="int" For="() => Model.MinPlayers" />
            </FormField>

            <FormField TValue="int" Label="Maks spillere" InputId="max-players">
                <InputNumber id="max-players"
                             class="@NumberClass(() => Model.MaxPlayers)"
                             @bind-Value="Model.MaxPlayers" />
                <FormValidationMessage TValue="int" For="() => Model.MaxPlayers" />
            </FormField>

            <FormField TValue="int" Label="Spilletid (minutter)" InputId="play-time">
                <InputNumber id="play-time"
                             class="@NumberClass(() => Model.PlayTimeMinutes)"
                             @bind-Value="Model.PlayTimeMinutes" />
                <FormValidationMessage TValue="int" For="() => Model.PlayTimeMinutes" />
            </FormField>
        </div>
    </div>

    <FormTextAreaField Label="Beskrivelse" Rows="5" @bind-Value="Model.Description" />

    <FormField TValue="int" Label="Terningkast" InputId="rating">
        <DiceRating @bind-Value="Model.Rating" />
        <FormValidationMessage TValue="int" For="() => Model.Rating" />
    </FormField>

    <div class="flex gap-3">
        <button type="submit"
                class="rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800">
            Lagre
        </button>
        <button type="button"
                class="rounded-md border border-zinc-300 px-4 py-2 text-sm"
                @onclick="Cancel">
            Avbryt
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public GameFormModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<GameFormModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    private string NumberClass(System.Linq.Expressions.Expression<Func<int>> field)
    {
        var invalid = EditContext?.GetValidationMessages(FieldIdentifier.Create(field)).Any() == true;
        return FormFieldStyles.Control(invalid);
    }

    private async Task HandleValidSubmit()
    {
        await OnSave.InvokeAsync(Model);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}